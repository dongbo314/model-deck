# Copy this file to ../../modeldeck.env before running Docker Compose.
# Add only the provider credentials named by your providers.json file.
# Never commit modeldeck.env or paste its values into issue reports.

# MODELDECK_PROVIDER_TEAM_KEY=replace-with-your-provider-key
# MODELDECK_API_KEY=replace-with-a-strong-local-api-token
